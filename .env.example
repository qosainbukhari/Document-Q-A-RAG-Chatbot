# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored, so your keys never get committed.

# ---------- LLM (required for /chat and the evaluation judges) ----------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---------- Embeddings (runs locally on CPU) ----------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- Storage ----------
# Where Chroma + the parent/BM25 docstore are saved. Leave empty to keep
# everything in memory (lost on restart).
CHROMA_DB_DIR=models/chroma_db

# ---------- Pipeline settings ----------
# Which config file the API loads. Technique ON/OFF flags live in there.
CONFIG_PATH=configs/config.yaml

# ---------- Streamlit frontend ----------
# docker-compose: http://backend:8000   local: http://localhost:8000
API_URL=http://localhost:8000

# ---------- Observability (optional) ----------
# Leave empty to run without tracing. Free cloud keys: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
